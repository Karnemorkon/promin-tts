{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Promin TTS",
  "version": "0.19.0",
  "identifier": "com.karnemorkon.promin-tts",
  "build": {
    "frontendDist": "../../crates/speech-server/web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Promin TTS",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' http: https:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["bin/speech-server", "bin/libonnxruntime.so.1"],
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
