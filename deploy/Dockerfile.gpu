# syntax=docker/dockerfile:1

# GPU image: ONNX Runtime 1.31.0 with the CUDA execution provider.
#
# Honest profile (див. crates/speech-inference/src/runtime.rs):
# * бінарник збирається з ознакою `gpu` (`ort/cuda` + `ort/load-dynamic`),
#   тому builder-етап НЕ завантажує і НЕ лінкує ONNX Runtime — CUDA EP
#   реєструється через OrtApi function table;
# * у runtime-образі лежить onnxruntime-linux-x64-gpu_cuda12, який
#   dlopen-иться при старті; CUDA застосовується лише якщо
#   `GetAvailableProviders` повідомляє про CUDAExecutionProvider
#   (PROMIN_ORT_EP=auto, типово) — інакше тихий fallback на CPU;
# * NVIDIA Container Toolkit обов'язковий на хості: без нього CUDA EP
#   не реєструється, а за неправильної конфігурації CUDA (за документацією
#   ort) можливий жорсткий crash процесу при першому Run — тому цей образ
#   призначений лише для хостів із GPU (deploy/docker-compose.gpu.yml).

# --- Web UI (React + TypeScript + Vite) -----------------------------------
FROM node:22-bookworm-slim AS web

WORKDIR /web
COPY crates/speech-server/web/package.json crates/speech-server/web/package-lock.json ./
RUN npm ci
COPY crates/speech-server/web/ ./
RUN npm run build

# --- Rust server ----------------------------------------------------------
FROM rust:1-bookworm AS builder

WORKDIR /build

# cmake/g++ — для sentencepiece-sys (static). ORT на етапі збірки не
# потрібен: `ort/load-dynamic` пропускає лінкування, `ORT_STRATEGY=system`
# забороняє непотрібне завантаження 400 МБ бінарників ORT.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates cmake g++ make \
    && rm -rf /var/lib/apt/lists/*

ENV ORT_STRATEGY=system

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY --from=web /web/dist ./crates/speech-server/web/dist
RUN cargo build --release -p speech-server --bins --features gpu

FROM nvidia/cuda:12.9.2-cudnn-runtime-ubuntu24.04

ARG ORT_VERSION=1.31.0

# OFFICIAL ORT GPU build (CUDA 12 + cuDNN 9). 450 МБ; розпаковуємо лише lib.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL -o /tmp/ort.tgz \
        "https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/onnxruntime-linux-x64-gpu_cuda12-${ORT_VERSION}.tgz" \
    && tar -xzf /tmp/ort.tgz -C /opt \
    && mv "/opt/onnxruntime-linux-x64-gpu_cuda12-${ORT_VERSION}" /opt/ort \
    && rm /tmp/ort.tgz \
    && mkdir -p /data/models /data/speakers /data/jobs /data/projects

COPY --from=builder /build/target/release/speech-server /usr/local/bin/speech-server
COPY --from=builder /build/target/release/promin-mcp /usr/local/bin/promin-mcp

# ORT_DYLIB_PATH — явний шлях для dlopen (ort/load-dynamic); LD_LIBRARY_PATH
# додатково для транзитивних залежностей GPU-бібліотек.
# PROMIN_ORT_EP=auto: CUDA за наявності, інакше CPU (перевірка у /healthz
# полем `execution_provider`).
ENV LD_LIBRARY_PATH=/opt/ort/lib \
    ORT_DYLIB_PATH=/opt/ort/lib/libonnxruntime.so.${ORT_VERSION} \
    PROMIN_ORT_EP=auto \
    PROMIN_HTTP_ADDR=0.0.0.0:8010 \
    PROMIN_WYOMING_ADDR=0.0.0.0:10200 \
    PROMIN_MODELS_DIR=/data/models \
    PROMIN_SPEAKERS_DIR=/data/speakers \
    PROMIN_JOBS_DIR=/data/jobs \
    PROMIN_PROJECTS_DIR=/data/projects \
    PROMIN_LOUDNESS_TARGET=-19 \
    PROMIN_TRUE_PEAK=-3 \
    PROMIN_AUTO_DOWNLOAD=auto \
    PROMIN_THREADS=4 \
    RUST_LOG=info

EXPOSE 8010 10200

# curl is intentionally not installed: bash + /dev/tcp keeps the image small.
# The port follows PROMIN_HTTP_ADDR, so a custom listen port keeps working.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["bash", "-c", "addr=\"${PROMIN_HTTP_ADDR:-0.0.0.0:8010}\"; port=\"${addr##*:}\"; exec 3<>/dev/tcp/127.0.0.1/$port && printf 'GET /healthz HTTP/1.0\\r\\n\\r\\n' >&3 && head -n1 <&3 | grep -q '200'"]

ENTRYPOINT ["/usr/local/bin/speech-server"]
